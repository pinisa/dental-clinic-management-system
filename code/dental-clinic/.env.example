# Local defaults use a file-backed H2 database; no env vars are required.
# For PostgreSQL/Neon, set SPRING_PROFILES_ACTIVE=prod and uncomment/fill these locally:
# SPRING_PROFILES_ACTIVE=prod
# DB_URL=jdbc:postgresql://<host>/<database>?sslmode=require
# DB_USERNAME=<database-user>
# DB_PASSWORD=<database-password>
